# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Uygulama alan adının kökünde çalışır (https://erenosmobile.bulenttayfur.com); alt yol gerekmez.
# Bir alt yolda yayınlanacaksa açın, ör. NEXT_PUBLIC_BASE_PATH=/mobiluygulama ("/" kök demektir).
# NEXT_PUBLIC_BASE_PATH=/

# Kullanıcı adları arka planda bu alan adıyla e-postaya çevrilir (ör. ali@erenos.local)
AUTH_EMAIL_DOMAIN=erenos.local

# Web Push (npm run vapid ile üretin)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bilgi@erenosmedikal.com

# Hatırlatma işini tetikleyen istekler için gizli anahtar (uzun rastgele bir metin)
CRON_SECRET=
